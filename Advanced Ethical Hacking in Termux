    #!/usr/bin/env python3
    # save as recon.py

    import subprocess
    import sys

    target = sys.argv[1]
    print(f"[*] Starting recon on {target}")

    # Nmap scan
    print("[*] Running Nmap...")
    result = subprocess.run(['nmap', '-sV', '-O', target],
                            capture_output=True, text=True)
    print(result.stdout)

    # DNS lookup
    print("[*] DNS Info...")
    result = subprocess.run(['dig', target, 'ANY'],
                            capture_output=True, text=True)
    print(result.stdout)

    # HTTP headers
    print("[*] HTTP Headers...")
    result = subprocess.run(['curl', '-I', f'http://{target}'],
                            capture_output=True, text=True)
    print(result.stdout)

    with open(f"{target}_report.txt", "w") as f:
        f.write(result.stdout)
    print(f"[+] Report saved to {target}_report.txt")

